{
  "version": 2,
  "regions": ["icn1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "src/**,config/**,public/**,node_modules/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/smart-sa/api/cron/autobid",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/smart-sa/api/cron/shopping-autobid",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/smart-sa/api/cron/sync-dashboard",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/smart-sa/api/cron/sync-backfill",
      "schedule": "30 23 * * *"
    },
    {
      "path": "/smart-sa/api/cron/cleanup-old-data",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/smart-sa/api/cron/daily",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/smart-sa/api/cron/weekly",
      "schedule": "0 0 * * 1"
    },
    {
      "path": "/smart-sa/api/cron/monthly",
      "schedule": "0 0 1 * *"
    }
  ]
}
